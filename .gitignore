# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Jupyter
.ipynb_checkpoints/

# Data (raw and intermediate data never committed; data/app/ is committed)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
*.zip

# Models (artifacts are regenerated by the pipeline)
models/*
!models/.gitkeep

# Secrets and credentials
kaggle.json
.kaggle/
.env
.env.*
*.pem
*.key
.streamlit/secrets.toml

# IDE and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
